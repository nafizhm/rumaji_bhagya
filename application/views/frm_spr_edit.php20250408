 <script>
$("a#confirm").click(function(e) {
	var url = $(this).attr('href');
	var title = $(this).attr('title');
	e.preventDefault();
	
	bootbox.confirm("Hapus dokumen "+title+" ?", function(result) {
		if(result)
		{
			location.href=url;
		}
	}); 
 
});
