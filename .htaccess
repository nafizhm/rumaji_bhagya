RewriteEngine On
# Use the current directory so the app works at /rumaji/ locally and / on hosting.
RewriteRule ^index\.php(?:/|$) - [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php/$1 [L]
SetEnv CI_ENV "production"
SetEnv DB_ONLINE "db_test"
SetEnv TGL_VER "2020-04-20"
